# profiles/base.env — what the base has been changed to, and when.
#
# Written by bin/arm.sh promote, and by hand only for things that are not an
# experiment. lib/config.sh applies this as the FLOOR: the environment, a
# profile and an arm all still outrank it.
#
# changed 2026-08-13: generate more, not less. Skimming is fast and a bigger
# pool is a better sample; the curator still prunes to the caps below.
MAX_NEW=12
MAX_LONG=8
MAX_SHORT=16

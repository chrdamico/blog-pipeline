# promoted 2026-08-14: arm glue30

CLEANUP_DIRECTIVE=$BLOG_REPO_DIR/profiles/directives/cleanup-nofiller.md
CURATE_DIRECTIVE=$BLOG_REPO_DIR/profiles/directives/propose-generously.md
GATE_TRACE=1
GLUE_MAX_WORDS=20
MAX_LONG=4
MAX_NEW=60
MAX_SHORT=8
NEW_SLACK_EVERY=6
VERBATIM_MIN=70

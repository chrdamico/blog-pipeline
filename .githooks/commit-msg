#!/usr/bin/env bash
# .githooks/commit-msg — the "nothing personal" gate for the MESSAGE.
#
# File contents are checked by pre-commit (tests/check_privacy.sh), but a
# commit message gets pushed too, and nothing was checking it — a real name
# in `git log` leaks exactly like one in a file. Same markers as layer 4
# there: the work email pattern, and every real name from private/aliases.tsv
# (read at run time so no name is embedded here; skipped where absent).
# Wired up by install.sh via: git config core.hooksPath .githooks
set -u
cd "$(git rev-parse --show-toplevel)"
msg="$1"
fail=0

if grep -qE '[A-Za-z0-9._%+-]+@smart-steel[a-z-]*\.[a-z]+' "$msg"; then
  echo 'COMMIT-MSG FAIL: work email address in the commit message' >&2
  fail=1
fi

if [ -f private/aliases.tsv ]; then
  while IFS=$'\t' read -r real _; do
    [ -n "$real" ] || continue
    case $real in '#'*) continue ;; esac
    if grep -qwF "$real" "$msg"; then
      echo "COMMIT-MSG FAIL: real name '$real' (private/aliases.tsv) in the commit message" >&2
      fail=1
    fi
  done < private/aliases.tsv
fi

if [ "$fail" -ne 0 ]; then
  echo 'Commit blocked: the message may not contain personal markers.' >&2
  exit 1
fi

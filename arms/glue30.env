# arm: glue30
# glue capped at 30% of a post's sentences, down from 45%
# created 2026-08-14. Deltas from the base; everything unlisted falls through.
#
# Runs every day beside the base, into sync/Obsidian/Posts/glue30/.
# bin/arm.sh promote glue30 folds these into profiles/base.env.

VERBATIM_MIN=70

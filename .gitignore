# Personal data — never commit
# (tests/check_privacy.sh — also the pre-commit hook — enforces this list)
# sync/ is the Syncthing folder: recordings, the Obsidian vault (notes), and
# the generated post suggestions all live under it.
sync/
drafts/
logs/
work/
# private/aliases.tsv: real-name -> alias map (see bin/suggest.sh, ALIASES)
private/
# your writing sample — copy prompts/style-anchor.example.md and fill it in
prompts/style-anchor.md
# local design/handoff notes, not part of the public repo
PLAN.md

# Large local artifacts
models/

# Build artifacts generated by install.sh
vendor/
bin/whisper-cli

# Audio anywhere in the tree
*.wav
*.m4a
*.mp3
*.opus
*.ogg
*.flac
